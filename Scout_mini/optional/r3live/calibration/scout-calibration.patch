new file mode 100644
index 0000000..adbfd39
--- /dev/null
+++ b/include/scout_headless.h
@@ -0,0 +1,14 @@
+#pragma once
+#include <opencv2/opencv.hpp>
+#include <cstdlib>
+#include <algorithm>
+#include <string>
+inline bool scout_headless() { return std::getenv("SCOUT_CALIB_HEADLESS") != nullptr; }
+inline void scout_show(std::string name, const cv::Mat &image) {
+  if (!scout_headless()) { cv::imshow(name,image); return; }
+  const char *directory=std::getenv("SCOUT_CALIB_OUTPUT");
+  if (!directory || image.empty()) return;
+  std::replace(name.begin(),name.end(),' ','_');
+  cv::imwrite(std::string(directory)+"/"+name+".png",image);
+}
+inline int scout_wait(int delay=0) { return scout_headless() ? -1 : cv::waitKey(delay); }
