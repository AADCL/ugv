+void mid360_handler(const livox_ros_driver2::CustomMsg::ConstPtr &msg)
+{
+    if (msg->point_num != msg->points.size() || msg->header.stamp.isZero())
+        return;
+    pcl::PointCloud<PointType> cloud;
+    cloud.reserve(msg->points.size() / g_LiDAR_sampling_point_step + 1);
+    for (size_t i = 0; i < msg->points.size(); i += g_LiDAR_sampling_point_step)
+    {
+        const auto &p = msg->points[i];
+        if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z) ||
+            p.line >= N_SCANS || (p.tag & 0x30) > 0x10 ||
+            p.x*p.x + p.y*p.y + p.z*p.z < blind*blind)
+            continue;
+        PointType point{};
+        point.x=p.x; point.y=p.y; point.z=p.z;
+        point.intensity=p.reflectivity;
+        point.curvature=p.offset_time*1e-6; // ns -> ms; retain per-point acquisition time
+        cloud.push_back(point);
+    }
+    // Mid-360 is 360 degrees: do not apply Avia's forward-X > 0.7 filter.
+    if (cloud.size() >= 100)
+        pub_func(cloud, pub_surf, msg->header.stamp);
+}
