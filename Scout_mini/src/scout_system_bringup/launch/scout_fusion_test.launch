<launch>
  <!-- Use scout_fusion_test.py for preflight checks. No NDT/map/navigation nodes. -->
  <arg name="output_root" default="$(env HOME)/livox_fastlio/logs/fusion_tests" />
  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" />
  <include file="$(find scout_system_bringup)/launch/fastlio_local_odom.launch" />
  <include file="$(find scout_tf_manager)/launch/tf_manager.launch" />
  <include file="$(find scout_pose_adapter)/launch/pose_adapter.launch" />
  <include file="$(find scout_bringup)/launch/scout_mini_robot_base.launch">
    <arg name="odom_topic_name" value="/scout/odom" />
    <arg name="pub_tf" value="false" />
  </include>
  <include file="$(find scout_odom_fusion)/launch/fusion.launch" />
  <node pkg="scout_odom_fusion" type="compare_odometry.py" name="scout_odom_comparison" output="screen">
    <param name="output_root" value="$(arg output_root)" />
  </node>
</launch>
