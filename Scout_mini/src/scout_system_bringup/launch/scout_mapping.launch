<launch>
  <arg name="enable_shadow_fusion" default="true" />
  <include if="$(arg enable_shadow_fusion)" file="$(find scout_odom_fusion)/launch/fusion.launch" />
  <!-- Operator entry, matching WheelTech: roslaunch with map_name:=NAME.
       Stop the vehicle, press Ctrl+C and wait for mapper shutdown saving.
       Then run: rosrun scout_map_tools finalize_map.py NAME -->

  <arg name="map_name" default="current_mapping" />
  <!-- Legacy Patchwork++ accumulation is diagnostic only. The default offline
       terrain builder now works directly from the Bayesian static PCD. -->
  <arg name="enable_online_terrain_diagnostics" default="false" />
  <!--
    Terrain mapping shares the Bayesian-filtered scan with the static PCD.
    Diagnostic fallback only: terrain_input_topic:=/cloud_registered_body
  -->
  <arg name="terrain_input_topic" default="/scout/static_scan" />

  <!-- 1. Mid-360 -->
  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" />

  <!-- 2. FAST-LIO odometry and registered cloud (native PCD saving disabled) -->
  <include file="$(find scout_system_bringup)/launch/fastlio_mapping_scout.launch">
    <arg name="rviz" value="false" />
  </include>

  <!-- 3. Filter registered scans and build the deliverable static PCD -->
  <include file="$(find scout_pointcloud_mapper)/launch/pointcloud_mapper.launch">
    <arg name="map_name" value="$(arg map_name)" />
  </include>

  <!-- 4. TF -->
  <include file="$(find scout_tf_manager)/launch/tf_manager.launch" />

  <!-- 5. odom -> base_link 发布为 /fastlio_odom -->
  <include file="$(find scout_pose_adapter)/launch/pose_adapter.launch" />

  <!-- 6. Scout Mini CAN chassis. Wheel odometry is a velocity source only. -->
  <include file="$(find scout_bringup)/launch/scout_mini_robot_base.launch">
    <arg name="odom_topic_name" value="/scout/odom" />
    <arg name="pub_tf" value="false" />
  </include>

  <!-- 7. Optional online Patchwork++ diagnostics / legacy classified PCDs. -->
  <include file="$(find scout_cloud_adapter)/launch/cloud_adapter.launch"
           if="$(arg enable_online_terrain_diagnostics)">
    <arg name="node_name" value="scout_terrain_cloud_adapter" />
    <arg name="input_topic" value="$(arg terrain_input_topic)" />
    <arg name="output_topic" value="/cloud_registered_terrain" />
    <arg name="target_frame" value="terrain_sensor" />
  </include>

  <include file="$(find scout_terrain_filter)/launch/scout_terrain_filter.launch"
           if="$(arg enable_online_terrain_diagnostics)">
    <!-- The accumulator consumes Patchwork++ directly. The terrain guard is a
         diagnostic branch and is disabled in deliverable maps. -->
    <arg name="enable_guard" value="false" />
  </include>

  <include file="$(find scout_terrain_filter)/launch/terrain_map_accumulator.launch"
           if="$(arg enable_online_terrain_diagnostics)">
    <arg name="map_name" value="$(arg map_name)" />
  </include>

</launch>
