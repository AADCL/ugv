<?xml version="1.0"?>
<package format="2">
  <name>scout_2p5d_navigation</name>
  <version>0.1.0</version>
  <description>Persistent 2.5D terrain mapping and terrain-aware navigation plugins for Scout Mini.</description>
  <maintainer email="114551361+BAIOLED@users.noreply.github.com">BAIOLED</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>costmap_2d</depend>
  <depend>boost</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <build_depend>libyaml-cpp-dev</build_depend>

  <export>
    <costmap_2d plugin="${prefix}/scout_2p5d_plugins.xml" />
  </export>
</package>
