<launch>
  <arg name="map_name" default="scout_map_01" />
  <arg name="map_dir" default="$(env HOME)/livox_fastlio/maps/$(arg map_name)" />
  <arg name="nav_map_yaml" default="$(arg map_dir)/map_raw.yaml" />
  <arg name="terrain_map_yaml" default="$(arg map_dir)/terrain_2p5d.yaml" />

  <node pkg="scout_system_bringup" type="map_bundle_guard.py"
        name="scout_planning_test_map_bundle_guard" output="screen" required="true">
    <param name="map_dir" value="$(arg map_dir)" />
    <param name="check_period" value="1.0" />
    <rosparam param="required_files" subst_value="true">
      - "$(arg map_dir)/map_metadata.yaml"
      - "$(arg nav_map_yaml)"
      - "$(arg map_dir)/map_raw.pgm"
      - "$(arg terrain_map_yaml)"
      - "$(arg map_dir)/terrain_2p5d_elevation.f32"
      - "$(arg map_dir)/terrain_2p5d_slope_deg.f32"
      - "$(arg map_dir)/terrain_2p5d_roughness.f32"
      - "$(arg map_dir)/terrain_2p5d_step_height.f32"
      - "$(arg map_dir)/terrain_2p5d_cost.u8"
      - "$(arg map_dir)/terrain_2p5d_confidence.u8"
    </rosparam>
  </node>

  <node pkg="map_server" type="map_server" name="scout_navigation_map_server"
        args="$(arg nav_map_yaml)" output="screen">
    <remap from="map" to="/nav_static_map" />
    <remap from="map_metadata" to="/nav_static_map_metadata" />
  </node>

  <node pkg="scout_2p5d_navigation" type="terrain_map_server_node"
        name="scout_terrain_map_server" output="screen">
    <param name="terrain_map_yaml" value="$(arg terrain_map_yaml)" />
  </node>

  <!-- Build the real global costmap but block cmd_vel for planning-only tests. -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam command="load" file="$(find scout_navigation)/config/move_base_slope_teb.yaml" />
    <rosparam command="load" ns="global_costmap"
              file="$(find scout_navigation)/config/costmap_common.yaml" />
    <rosparam command="load" ns="global_costmap"
              file="$(find scout_navigation)/config/global_costmap_slope.yaml" />
    <rosparam command="load" ns="local_costmap"
              file="$(find scout_navigation)/config/costmap_common.yaml" />
    <rosparam command="load" ns="local_costmap"
              file="$(find scout_navigation)/config/local_costmap_slope.yaml" />
    <rosparam command="load" file="$(find scout_navigation)/config/global_planner_slope.yaml" />
    <rosparam command="load" file="$(find scout_navigation)/config/teb_local_planner.yaml" />
    <param name="global_costmap/terrain_slope_layer/terrain_map_yaml"
           value="$(arg terrain_map_yaml)" />
    <param name="local_costmap/obstacle_layer/enabled" value="false" />
    <remap from="odom" to="/scout/odom" />
    <remap from="cmd_vel" to="/scout_navigation/cmd_vel_blocked" />
  </node>

  <node pkg="scout_navigation" type="global_plan_tester.py"
        name="scout_global_plan_tester" output="screen" />
</launch>
