<launch>

	<arg name="map_name" default="wheeltec_map_01" />

	<arg name="map_dir" default="$(env HOME)/livox_fastlio/maps/$(arg map_name)" />

	<arg name="map_pcd" default="$(arg map_dir)/public_map.pcd" />

	<arg name="map_yaml" default="$(arg map_dir)/map.yaml" />

	<!-- 1. Mid-360 -->
	<include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" />

	<!-- 2. FAST-LIO local odometry -->
	<include file="$(find wheeltec_system_bringup)/launch/include/fastlio_local_odom.launch.xml" />

	<!-- 3. 固定 TF：内部加载 wheeltec_geometry.yaml -->
	<include file="$(find wheeltec_tf_manager)/launch/include/tf_manager.launch.xml" />

	<!-- 4. odom -> base_link Odometry -->
	<include file="$(find wheeltec_pose_adapter)/launch/include/pose_adapter.launch.xml" />

	<!-- 5. body 点云 -> base_link 点云 -->
	<include file="$(find wheeltec_cloud_adapter)/launch/include/cloud_adapter.launch.xml" />

	<!-- 6. PCD 全局重定位 -->
	<include file="$(find wheeltec_system_bringup)/launch/include/wheeltec_relocalization.launch.xml">
		<arg name="map_pcd" value="$(arg map_pcd)" />
	</include>

	<!-- 7. 2D OccupancyGrid -->
	<node pkg="map_server" type="map_server" name="wheeltec_map_server" args="$(arg map_yaml)" output="screen">

		<remap from="map" to="/map_2d" />
	</node>

	<!-- 8. WheelTech serial chassis. /odom is wheel-speed feedback only. -->
	<include file="$(find turn_on_wheeltec_robot)/launch/include/base_serial.launch">
		<arg name="odom_frame_id" value="wheel_odom" />
	</include>

</launch>
