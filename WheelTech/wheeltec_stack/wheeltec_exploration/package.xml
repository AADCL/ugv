<?xml version="1.0"?>
<package format="2">
  <name>wheeltec_exploration</name>
  <version>0.1.0</version>
  <description>Frontier goal selection using the shared WheelTech mapping and navigation entries.</description>
  <maintainer email="114551361+BAIOLED@users.noreply.github.com">BAIOLED</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>costmap_2d</depend>
  <depend>diagnostic_msgs</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav_core</depend>
  <depend>teb_local_planner</depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-nose</test_depend>
  <exec_depend>explore_lite</exec_depend>
  <exec_depend>wheeltec_explore_lite</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>wheeltec_safety</exec_depend>
  <exec_depend>wheeltec_exploration_driver</exec_depend>
  <exec_depend>wheeltec_system_bringup</exec_depend>
  <exec_depend>wheeltec_navigation</exec_depend>
