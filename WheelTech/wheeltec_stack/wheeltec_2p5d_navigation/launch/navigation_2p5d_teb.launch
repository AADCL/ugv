<launch>
  <arg name="map_name" default="wheeltec_map_01" />
  <arg name="map_dir" default="$(env HOME)/livox_fastlio/maps/$(arg map_name)" />
  <arg name="nav_map_yaml" default="$(arg map_dir)/map_raw.yaml" />
  <arg name="terrain_map_yaml" default="$(arg map_dir)/terrain_2p5d.yaml" />
  <arg name="odom_topic" default="/odom" />
  <arg name="cmd_vel_topic" default="/cmd_vel" />

  <!-- Existing point-cloud processing remains unchanged and supplies live obstacle updates. -->
  <include file="$(find wheeltec_cloud_adapter)/launch/cloud_adapter.launch">
    <arg name="node_name" value="wheeltec_terrain_cloud_adapter" />
    <arg name="output_topic" value="/cloud_registered_terrain" />
    <arg name="target_frame" value="terrain_sensor" />
  </include>
  <include file="$(find wheeltec_terrain_filter)/launch/wheeltec_terrain_filter.launch" />

  <node pkg="map_server" type="map_server" name="wheeltec_navigation_map_server"
        args="$(arg nav_map_yaml)" output="screen">
    <remap from="map" to="/nav_static_map" />
    <remap from="map_metadata" to="/nav_static_map_metadata" />
  </node>

  <node pkg="wheeltec_2p5d_navigation" type="terrain_map_server_node"
        name="wheeltec_terrain_map_server" output="screen">
    <param name="terrain_map_yaml" value="$(arg terrain_map_yaml)" />
  </node>

  <!-- 2.5D global planning + TEB local planning. -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam command="load" file="$(find wheeltec_2p5d_navigation)/config/move_base_2p5d_teb.yaml" />
    <rosparam command="load" ns="global_costmap"
              file="$(find wheeltec_navigation)/config/costmap_common.yaml" />
    <rosparam command="load" ns="global_costmap"
              file="$(find wheeltec_2p5d_navigation)/config/global_costmap_2p5d.yaml" />
    <rosparam command="load" ns="local_costmap"
              file="$(find wheeltec_navigation)/config/costmap_common.yaml" />
    <rosparam command="load" ns="local_costmap"
              file="$(find wheeltec_2p5d_navigation)/config/local_costmap_2p5d.yaml" />
    <rosparam command="load" file="$(find wheeltec_navigation)/config/teb_local_planner.yaml" />
    <rosparam command="load" file="$(find wheeltec_2p5d_navigation)/config/terrain_global_planner.yaml" />

    <param name="TerrainGlobalPlanner/terrain_map_yaml" value="$(arg terrain_map_yaml)" />
    <param name="terrain_map_yaml" value="$(arg terrain_map_yaml)" />
    <param name="global_costmap/terrain_2p5d_layer/terrain_map_yaml" value="$(arg terrain_map_yaml)" />
    <param name="local_costmap/terrain_2p5d_layer/terrain_map_yaml" value="$(arg terrain_map_yaml)" />

    <!-- TEB follows the terrain-aware global path while retaining local obstacle avoidance. -->
    <param name="TebLocalPlannerROS/global_plan_viapoint_sep" value="0.30" />
    <param name="TebLocalPlannerROS/weight_viapoint" value="3.0" />
    <remap from="odom" to="$(arg odom_topic)" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)" />
  </node>
</launch>
